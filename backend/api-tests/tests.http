### Variables

# Base URL is now provided by http-client.env.json
# Ensure you select the 'dev' environment in IntelliJ's top-right "Run with:" dropdown.

### 1. User Registration
# This saves the generated User ID to a global variable 'userId'
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

> {%
    client.global.set("userId", response.body.id);
%}

### 2. User Login
# This saves the JWT token to a global variable 'authToken'
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

> {%
    client.global.set("authToken", response.body.token);
%}

### 3. Add Vehicle to User
# Uses the 'userId' and 'authToken' captured above
POST {{baseUrl}}/vehicles/user/{{userId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "licensePlate": "ABC-12345",
  "vehicleCategory": "B",
  "isElectric": true
}

> {%
    client.global.set("vehicleId", response.body.id);
%}
### 4. Create Parking Area
# This saves the created Area ID to 'areaId'
POST {{baseUrl}}/parking-areas
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Central Plaza Parking",
  "address": "123 Main St",
  "capacity": 100,
  "hourlyRate": 5.50,
  "latitude": 40.7128,
  "longitude": -74.0060
}

> {%
    client.global.set("areaId", response.body.id);
%}

### 5. Find Nearby Parking Areas
GET {{baseUrl}}/parking-areas/nearby?lat=40.7128&lon=-74.0060&radius=1000
Authorization: Bearer {{authToken}}

### 6. Get Available Slots for Area
# Uses the 'areaId' captured in Step 4
GET {{baseUrl}}/parking-areas/{{areaId}}/available-slots?size=STANDARD
Authorization: Bearer {{authToken}}

### 7. Get All Parking Areas
GET {{baseUrl}}/parking-areas
Authorization: Bearer {{authToken}}

### 8. Delete Vehicle
# Replace {{vehicleId}} with a specific ID or add a capture script to the 'Add Vehicle' request
DELETE {{baseUrl}}/vehicles/{{vehicleId}}?userId={{userId}}
Authorization: Bearer {{authToken}}

### 9. Create Parking Ticket
# Trimite cererea de creare a unui tichet pentru 2 ore
//Replace slotID with a specific ID
//momentan adaugam slotId-ul manual
POST {{baseUrl}}/tickets/create?vehicleId={{vehicleId}}&parkingSlotId=092ce89f-a488-461e-bf43-15abd7173789&hours=2&userId={{userId}}
Authorization: Bearer {{authToken}}

> {%
    client.log("--- ANALIZĂ CORP RĂSPUNS ---");
    client.log(JSON.stringify(response.body));

    // Încercăm să salvăm ID-ul căutând în toate variantele posibile
    let ticketId = response.body.id || response.body.ticketId || response.body.idTicket;

    if (ticketId) {
        client.global.set("ticketId", ticketId);
        client.log("ID SALVAT: " + ticketId);
    } else {
        client.log("NU S-A GĂSIT ID. Uită-te mai sus la JSON-ul printat și vezi cum se numește cheia pentru UUID.");
    }
    %}
### 10. Process Payment
POST {{baseUrl}}/payments/process?ticketId={{ticketId}}&amount=11.00&currency=RON
Authorization: Bearer {{authToken}}

> {%
    client.global.set("paymentId", response.body.id);
    client.log("Plată procesată pentru tichetul: " + client.global.get("ticketId"));
%}


### 11. Extend Ticket Duration
# Prelungim cu 3 ore
PUT {{baseUrl}}/tickets/{{ticketId}}/extend?noOfHours=3
Authorization: Bearer {{authToken}}

> {%
    client.log("Prelungire efectuată cu succes.");
%}


### 12. Get Ticket Details
GET {{baseUrl}}/tickets/{{ticketId}}
Authorization: Bearer {{authToken}}

> {%
    client.log("Status: " + response.body.status);
    client.log("Expiră la: " + response.body.endTime);
%}


### 13. Get Payment Details
# Verificăm dacă plata a fost salvată corect în DB
GET {{baseUrl}}/payments/{{paymentId}}
Authorization: Bearer {{authToken}}


